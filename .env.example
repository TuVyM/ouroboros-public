# Binance API (required for live trading — leave blank for dry-run)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading
DRY_RUN=true                    # set false for live trading (careful)
SYMBOLS=BTCUSDT

# Scalp layer
SCALPER_BALANCE_FRACTION=0.33   # fraction of total balance for scalp slice
SCALP_SL_PCT=0.0020             # stop-loss % (overrides ATR-based default)
SCALP_TP_PCT=0.0020             # take-profit % (overrides ATR-based default)

# Position sizing (LGBM path)
MIN_CONFIDENCE=0.55             # minimum confidence to open a position
MAX_POSITION_PCT=0.02           # Kelly fraction cap (2% of balance)
PAPER_PORTFOLIO_USDC=300.0      # starting paper balance
